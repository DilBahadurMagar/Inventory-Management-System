# Option A (recommended if password has @, #, /, etc.): separate fields
DB_HOST=aws-1-ap-northeast-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your-database-password-here

# Option B: single URL — encode @ in password as %40 (only ONE @ before host)
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:my%40pass@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# CORS Allowed Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

